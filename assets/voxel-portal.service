[Unit]
Description=Portal service (Voxel implementation)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.voxel
ExecStart=/usr/bin/voxel --portal
Restart=on-failure
Slice=session.slice

[Install]
WantedBy=graphical-session.target
